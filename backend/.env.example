# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or local, e.g. mongodb://127.0.0.1:27017/budgetbuddy)
MONGO_URI=

# Long random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS, comma-separated. The first one is used in email links.
CLIENT_URL=http://localhost:5173

# Set to true when running behind a reverse proxy (Render, Railway, Nginx...) so rate limiting sees real client IPs.
TRUST_PROXY=false

# Optional SMTP settings for password reset emails. Without them, reset links are logged to the
# console (and returned by the API in development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BudgetBuddy <no-reply@budgetbuddy.app>"
