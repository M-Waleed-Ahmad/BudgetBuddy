# Base URL of the BudgetBuddy API.
# Leave empty during development to use the Vite dev proxy (/api -> http://localhost:5000).
# In production set it to your deployed API, e.g. https://your-api.example.com/api
VITE_API_URL=

# Optional: Cloudinary unsigned upload preset used for profile pictures.
# When either value is empty, profile picture uploads are disabled in the UI.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
